# Server
PORT=5001
NODE_ENV=development

# ── PostgreSQL (Neon) ────────────────────────────────────────────────────────
# Neon dashboard → Connection Details → copy the POOLED connection string.
# Keep the ?sslmode=require suffix — node-postgres reads it from the URL.
# Paste the URL only: no surrounding quotes, no KEY= prefix, no trailing space.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Admin account (created by migration) ─────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=System Administrator

# ── Sample data ─────────────────────────────────────────────────────────────
# Set to "true" to seed 10 sample providers with work images around Ilaro
SEED_SAMPLE_DATA=false

# JWT Configuration
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# ── Client URL (CORS) ────────────────────────────────────────────────────────
# One origin, or several separated by commas. Each must match the frontend's
# origin character-for-character (scheme + host + port). Surrounding spaces and
# trailing slashes are stripped for you. Example covering prod and local dev:
#   CLIENT_URL=https://your-frontend.onrender.com,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Search radius (km)
DEFAULT_SEARCH_RADIUS=5
MAX_SEARCH_RADIUS=25

# ── Image uploads (Cloudinary) ───────────────────────────────────────────────
# Render's free tier has NO persistent disk — anything written locally is lost
# on every restart and redeploy. Uploads therefore go to Cloudinary.
# Cloudinary dashboard → copy the "API Environment variable", which already has
# the cloudinary://key:secret@cloud_name form.
# Leave unset locally to fall back to disk storage under ./uploads.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_FOLDER=findmyartisan

# NOTE: this file is a TEMPLATE and is committed to git. Never put real
# credentials here — they belong in .env (gitignored) or the host's dashboard.
