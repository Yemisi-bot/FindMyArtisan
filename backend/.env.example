# Server
PORT=5001
NODE_ENV=development

# PostgreSQL Database (Railway: use the provided DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/findmyartisan

# ── Admin account (created by migration) ─────────────────────────────────────
ADMIN_EMAIL=admin@findmyartisan.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator

# ── Sample data ─────────────────────────────────────────────────────────────
# Set to "true" to seed 10 sample providers with work images around Ilaro
SEED_SAMPLE_DATA=false

# JWT Configuration
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# Client URL (for CORS) — comma-separated list
CLIENT_URL=http://localhost:5173

# Search radius (km)
DEFAULT_SEARCH_RADIUS=5
MAX_SEARCH_RADIUS=25

# ── Email verification (OTP) — Brevo transactional API ──────────────────────
# Free (300 emails/day), no domain needed, sends over HTTPS so it works on
# Railway where SMTP is blocked. If unset, OTP codes print to the server console.
# 1. Sign up free at https://app.brevo.com
# 2. SMTP & API → API Keys → create a key
# 3. Senders, Domains & IPs → Senders → add + verify your email (e.g. your Gmail)
BREVO_API_KEY=xkeysib-your_api_key
EMAIL_FROM=your_verified_email@gmail.com
EMAIL_FROM_NAME=FindMyArtisan

# ── Image uploads ─────────────────────────────────────────────────────────────
# On Railway: create a Volume, mount it (e.g. at /data), then set UPLOAD_DIR=/data/uploads
# so artisan catalogs and review photos survive redeploys. Defaults to ./uploads locally.
# UPLOAD_DIR=/data/uploads
