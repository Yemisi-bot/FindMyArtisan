# FindMyArtisan frontend — build context is ../frontend
#
# VITE_API_URL is deliberately NOT set. The app then falls back to the relative
# "/api" (see src/services/api.ts), which nginx proxies to the API container.
# That means one origin, no CORS, and no host name compiled into the bundle.
#
# Files are copied individually so the developer's frontend/.env — which points
# at a deployed API — cannot be baked into this build.

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts index.html ./
COPY public ./public
COPY src ./src

RUN npm run build

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

# nginx.conf lives beside this Dockerfile, which is outside the build context
# (../frontend), so docker-compose mounts it in rather than COPYing it here.

EXPOSE 80
