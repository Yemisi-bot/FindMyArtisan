# Server
PORT=5001
NODE_ENV=development

# PostgreSQL Database (Railway: use the provided DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/findmyartisan

# ── Admin account (created by migration) ─────────────────────────────────────
ADMIN_EMAIL=admin@findmyartisan.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator

# ── Sample data ─────────────────────────────────────────────────────────────
# Set to "true" to seed 10 sample providers with work images around Ilaro
SEED_SAMPLE_DATA=false

# JWT Configuration
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# Client URL (for CORS) — comma-separated list
CLIENT_URL=http://localhost:5173

# Search radius (km)
DEFAULT_SEARCH_RADIUS=5
MAX_SEARCH_RADIUS=25

# ── Email verification (OTP) — Gmail SMTP via Nodemailer ─────────────────────
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords.
# Emails send from your real @gmail.com address (trusted domain → lands in inbox, not spam).
# If unset, OTP codes are printed to the server console (dev fallback).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Image uploads ─────────────────────────────────────────────────────────────
# On Railway: create a Volume, mount it (e.g. at /data), then set UPLOAD_DIR=/data/uploads
# so artisan catalogs and review photos survive redeploys. Defaults to ./uploads locally.
# UPLOAD_DIR=/data/uploads
