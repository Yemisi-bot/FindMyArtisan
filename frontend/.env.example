# ── API base URL ─────────────────────────────────────────────────────────────
# NOTE: Vite inlines this into the bundle at BUILD time, not at runtime.
# Changing it on the host requires a REBUILD, not just a restart.
# Must include the /api suffix, e.g. https://findmyartisan-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api

VITE_APP_NAME=FindMyArtisan
VITE_DEFAULT_RADIUS=5
VITE_MAX_RADIUS=25
